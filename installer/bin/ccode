#!/usr/bin/env bash
set -euo pipefail

# ccode wrapper behavior:
# - Version precedence: --version -> nearest ccode.yaml version -> ~/.config/ccode/version -> latest stable release
# - Normal command execution is read-only for version config files.
# - Cache/install writes are only under ~/.cache/ccode/releases
# - Built-in `pin` writes version atomically to ~/.config/ccode/version

GITHUB_REPO="cohesivestack/ccode"
GITHUB_API_BASE="https://api.github.com/repos/${GITHUB_REPO}"
CACHE_BASE="${XDG_CACHE_HOME:-$HOME/.cache}/ccode/releases"
GLOBAL_VERSION_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/ccode/version"

OS=""
ARCH=""
PLATFORM=""
ASSET_EXT=""
BINARY_NAME="ccode"

log_err() {
  printf 'ccode wrapper: %s\n' "$*" >&2
}

die() {
  log_err "$*"
  exit 1
}

trim_line() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  printf '%s' "$value"
}

normalize_version() {
  local input
  input="$(trim_line "${1:-}")"
  if [[ -z "$input" ]]; then
    printf ''
    return 0
  fi
  if [[ "$input" == "latest" ]]; then
    printf 'latest'
    return 0
  fi
  if [[ "$input" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([\-+][0-9A-Za-z.-]+)?$ ]]; then
    printf '%s' "$input"
    return 0
  fi
  if [[ "$input" =~ ^[0-9]+\.[0-9]+\.[0-9]+([\-+][0-9A-Za-z.-]+)?$ ]]; then
    printf 'v%s' "$input"
    return 0
  fi
  if [[ "$input" =~ ^v.+$ ]]; then
    printf '%s' "$input"
    return 0
  fi
  printf 'v%s' "$input"
}

read_version_file() {
  local file="$1"
  [[ -f "$file" ]] || return 1
  local line value
  line="$(tr -d '\r' <"$file" | sed -n '1p')"
  value="$(trim_line "$line")"
  [[ -n "$value" ]] || return 1
  printf '%s' "$value"
}

find_config_file() {
  if [[ -n "${CONFIG_FILE_ARG:-}" ]]; then
    printf '%s' "$CONFIG_FILE_ARG"
    return 0
  fi

  local dir="$PWD"
  while true; do
    local candidate="${dir}/ccode.yaml"
    if [[ -f "$candidate" ]]; then
      printf '%s' "$candidate"
      return 0
    fi
    if [[ "$dir" == "/" ]]; then
      return 1
    fi
    dir="$(dirname "$dir")"
  done
}

read_config_version() {
  local file="$1"
  [[ -f "$file" ]] || return 1

  local line value first last
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="$(trim_line "$line")"
    case "$line" in
      version:*)
        value="${line#version:}"
        value="${value%%#*}"
        value="$(trim_line "$value")"
        first="${value:0:1}"
        last="${value: -1}"
        if { [[ "$first" == '"' && "$last" == '"' ]] || [[ "$first" == "'" && "$last" == "'" ]]; } && [[ "${#value}" -ge 2 ]]; then
          value="${value:1:${#value}-2}"
        fi
        value="$(trim_line "$value")"
        [[ -n "$value" ]] || return 1
        printf '%s' "$value"
        return 0
        ;;
    esac
  done <"$file"

  return 1
}

is_semver_tag() {
  local version="$1"
  [[ "$version" =~ ^v[0-9]+\.[0-9]+\.[0-9]+([\-+][0-9A-Za-z.-]+)?$ ]]
}

detect_platform() {
  local uname_s uname_m
  uname_s="$(uname -s)"
  uname_m="$(uname -m)"

  case "$uname_s" in
    Linux) OS="linux" ;;
    Darwin) OS="darwin" ;;
    MINGW*|MSYS*|CYGWIN*) OS="windows" ;;
    *) die "unsupported operating system: ${uname_s}" ;;
  esac

  case "$uname_m" in
    x86_64|amd64) ARCH="amd64" ;;
    arm64|aarch64) ARCH="arm64" ;;
    *) die "unsupported architecture: ${uname_m}" ;;
  esac

  case "${OS}/${ARCH}" in
    linux/amd64|linux/arm64|darwin/amd64|darwin/arm64|windows/amd64) ;;
    *) die "unsupported platform: ${OS}/${ARCH}" ;;
  esac

  PLATFORM="${OS}_${ARCH}"
  if [[ "$OS" == "windows" ]]; then
    ASSET_EXT="zip"
    BINARY_NAME="ccode.exe"
  else
    ASSET_EXT="tar.gz"
    BINARY_NAME="ccode"
  fi
}

cache_install_dir() {
  local version="$1"
  printf '%s/%s/%s' "$CACHE_BASE" "$version" "$PLATFORM"
}

installed_binary_path() {
  local version="$1"
  printf '%s/%s' "$(cache_install_dir "$version")" "$BINARY_NAME"
}

github_api_get() {
  local path="$1"
  curl -fsSL \
    -H "Accept: application/vnd.github+json" \
    -H "X-GitHub-Api-Version: 2022-11-28" \
    "${GITHUB_API_BASE}${path}"
}

json_get_first_string_field() {
  local json="$1"
  local field="$2"
  printf '%s\n' "$json" | sed -n "s/.*\"${field}\":[[:space:]]*\"\\([^\"]*\\)\".*/\\1/p" | head -n1
}

find_asset_download_url() {
  local json="$1"
  local asset_name="$2"
  local url
  url="$(
    printf '%s\n' "$json" | awk -v wanted="$asset_name" '
      {
        line=$0
        if (line ~ /"name":[[:space:]]*"/) {
          name=line
          sub(/^.*"name":[[:space:]]*"/, "", name)
          sub(/".*$/, "", name)
          in_wanted=(name == wanted)
        } else if (in_wanted && line ~ /"browser_download_url":[[:space:]]*"/) {
          out=line
          sub(/^.*"browser_download_url":[[:space:]]*"/, "", out)
          sub(/".*$/, "", out)
          print out
          exit
        }
      }
    '
  )"
  [[ -n "$url" ]] || return 1
  printf '%s' "$url"
}

latest_stable_release_tag() {
  local json tag
  json="$(github_api_get '/releases/latest')"
  tag="$(json_get_first_string_field "$json" "tag_name")"
  [[ -n "$tag" ]] || die "failed to resolve latest stable release tag from GitHub"
  normalize_version "$tag"
}

release_asset_name_for_version() {
  local version="$1"
  local bare_version="${version#v}"
  printf 'ccode_%s_%s.%s' "$bare_version" "$PLATFORM" "$ASSET_EXT"
}

download_release_asset_url() {
  local version="$1"
  local asset_name="$2"
  local json url

  json="$(github_api_get "/releases/tags/${version}")"
  if url="$(find_asset_download_url "$json" "$asset_name" 2>/dev/null)"; then
    printf '%s' "$url"
    return 0
  fi

  printf 'https://github.com/%s/releases/download/%s/%s' "$GITHUB_REPO" "$version" "$asset_name"
}

ensure_dependency() {
  local cmd="$1"
  command -v "$cmd" >/dev/null 2>&1 || die "required command not found: ${cmd}"
}

install_version_if_needed() {
  local version="$1"
  local target_bin
  target_bin="$(installed_binary_path "$version")"
  if [[ -x "$target_bin" ]]; then
    printf '%s' "$target_bin"
    return 0
  fi

  local install_dir
  install_dir="$(cache_install_dir "$version")"
  mkdir -p "$install_dir"

  local tmp_dir
  tmp_dir="$(mktemp -d)"
  (
    set -euo pipefail
    trap 'rm -rf "$tmp_dir"' EXIT

    local asset_name asset_url archive extract_dir extracted_bin temp_bin
    asset_name="$(release_asset_name_for_version "$version")"
    asset_url="$(download_release_asset_url "$version" "$asset_name")"
    archive="${tmp_dir}/${asset_name}"
    extract_dir="${tmp_dir}/extract"
    mkdir -p "$extract_dir"

    curl -fL --retry 3 --retry-delay 1 -o "$archive" "$asset_url"

    if [[ "$ASSET_EXT" == "zip" ]]; then
      ensure_dependency unzip
      unzip -q "$archive" -d "$extract_dir"
    else
      tar -xzf "$archive" -C "$extract_dir"
    fi

    extracted_bin="$(find "$extract_dir" -type f -name "$BINARY_NAME" -print -quit)"
    [[ -n "$extracted_bin" ]] || die "downloaded asset did not contain ${BINARY_NAME}"

    temp_bin="${install_dir}/.${BINARY_NAME}.tmp.$$"
    cp "$extracted_bin" "$temp_bin"
    chmod +x "$temp_bin"
    mv -f "$temp_bin" "$target_bin"
  )

  printf '%s' "$target_bin"
}

pin_usage() {
  cat >&2 <<'EOF'
Usage:
  ccode pin
  ccode pin <version>
  ccode pin latest
EOF
}

pin_command() {
  shift
  local input_version=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      -*)
        pin_usage
        die "unknown argument for pin: $1"
        ;;
      *)
        if [[ -n "$input_version" ]]; then
          pin_usage
          die "too many positional arguments for pin"
        fi
        input_version="$1"
        ;;
    esac
    shift
  done

  local resolved_version target_dir target_file temp_file
  if [[ -z "$input_version" ]]; then
    resolved_version="$(latest_stable_release_tag)"
  elif [[ "$input_version" == "latest" ]]; then
    resolved_version="$(latest_stable_release_tag)"
  else
    resolved_version="$(normalize_version "$input_version")"
    if ! is_semver_tag "$resolved_version"; then
      pin_usage
      die "invalid version for pin: ${input_version}"
    fi
  fi

  target_dir="$(dirname "$GLOBAL_VERSION_FILE")"
  target_file="$GLOBAL_VERSION_FILE"

  mkdir -p "$target_dir"
  temp_file="$(mktemp "${target_dir}/version.tmp.XXXXXX")"
  printf '%s\n' "$resolved_version" >"$temp_file"
  mv -f "$temp_file" "$target_file"

  printf '%s\n' "$resolved_version"
}

REQUESTED_VERSION_ARG=""
CONFIG_FILE_ARG=""
COMMAND_NAME=""
FORWARDED_ARGS=()

parse_wrapper_args() {
  REQUESTED_VERSION_ARG=""
  CONFIG_FILE_ARG=""
  COMMAND_NAME=""
  FORWARDED_ARGS=()

  local expect_config=0
  local expect_version=0
  local expect_passthrough_value=0
  local arg

  for arg in "$@"; do
    if [[ "$expect_config" -eq 1 ]]; then
      CONFIG_FILE_ARG="$arg"
      FORWARDED_ARGS+=("$arg")
      expect_config=0
      continue
    fi
    if [[ "$expect_version" -eq 1 ]]; then
      REQUESTED_VERSION_ARG="$arg"
      expect_version=0
      continue
    fi
    if [[ "$expect_passthrough_value" -eq 1 ]]; then
      FORWARDED_ARGS+=("$arg")
      expect_passthrough_value=0
      continue
    fi

    case "$arg" in
      --config=*)
        CONFIG_FILE_ARG="${arg#--config=}"
        FORWARDED_ARGS+=("$arg")
        ;;
      --config)
        FORWARDED_ARGS+=("$arg")
        expect_config=1
        ;;
      --version=*)
        REQUESTED_VERSION_ARG="${arg#--version=}"
        ;;
      --version)
        expect_version=1
        ;;
      --ccode-path|--path|--output-path)
        FORWARDED_ARGS+=("$arg")
        expect_passthrough_value=1
        ;;
      --ccode-path=*|--path=*|--output-path=*)
        FORWARDED_ARGS+=("$arg")
        ;;
      *)
        FORWARDED_ARGS+=("$arg")
        if [[ -z "$COMMAND_NAME" && "$arg" != -* ]]; then
          COMMAND_NAME="$arg"
        fi
        ;;
    esac
  done

  [[ "$expect_config" -eq 0 ]] || die "--config requires a value"
  [[ "$expect_version" -eq 0 ]] || die "--version requires a value"
  [[ "$expect_passthrough_value" -eq 0 ]] || die "missing value for option"
}

validate_requested_version() {
  local value="$1"
  if [[ "$value" == "latest" ]] || is_semver_tag "$value"; then
    return 0
  fi
  return 1
}

resolve_requested_version() {
  local value config_file

  if [[ -n "$REQUESTED_VERSION_ARG" ]]; then
    value="$(normalize_version "$REQUESTED_VERSION_ARG")"
    validate_requested_version "$value" || die "invalid version for --version: ${REQUESTED_VERSION_ARG}"
    printf '%s' "$value"
    return 0
  fi

  if config_file="$(find_config_file 2>/dev/null)" && [[ -f "$config_file" ]]; then
    if value="$(read_config_version "$config_file" 2>/dev/null)"; then
      value="$(normalize_version "$value")"
      validate_requested_version "$value" || die "invalid version in ${config_file}: ${value}"
      printf '%s' "$value"
      return 0
    fi
    if [[ "$COMMAND_NAME" == "init" ]]; then
      latest_stable_release_tag
      return 0
    fi
    die "version is required in ${config_file}"
  fi

  if [[ "$COMMAND_NAME" == "init" ]]; then
    latest_stable_release_tag
    return 0
  fi

  if value="$(read_version_file "$GLOBAL_VERSION_FILE" 2>/dev/null)"; then
    value="$(normalize_version "$value")"
    validate_requested_version "$value" || die "invalid global pinned version: ${value}"
    printf '%s' "$value"
    return 0
  fi

  latest_stable_release_tag
}

main() {
  detect_platform
  mkdir -p "$CACHE_BASE"

  if [[ "${1:-}" == "pin" ]]; then
    pin_command "$@"
    return 0
  fi

  parse_wrapper_args "$@"

  local requested_version resolved_version real_binary
  requested_version="$(resolve_requested_version)"
  if [[ "$requested_version" == "latest" ]]; then
    resolved_version="$(latest_stable_release_tag)"
  else
    resolved_version="$requested_version"
  fi

  real_binary="$(install_version_if_needed "$resolved_version")"
  if [[ "$COMMAND_NAME" == "init" ]]; then
    FORWARDED_ARGS+=("--version" "$resolved_version")
  fi

  exec "$real_binary" "${FORWARDED_ARGS[@]}"
}

main "$@"
